{
  "name": "@workforce-os/runtime",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "AI Workforce OS runtime — governed multi-agent operating system (pre-production v0.4)",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "reset": "rm -f .data/workforce.db* && npm run migrate && npm run seed",
    "dev": "tsx watch src/api/main.ts",
    "start": "tsx src/api/main.ts",
    "smoke": "tsx scripts/smoke.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.122.0"
  }
}
