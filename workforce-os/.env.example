# AI Workforce OS v0.4 — local development configuration.
# No secret values belong in the database; runtime reads credentials from the
# process environment only, and stores nothing but opaque references.

WORKFORCE_DB_PATH=.data/workforce.db
WORKFORCE_PORT=8787

# Model provider. "mock" is the deterministic offline provider used by the test
# suite and by default; no paid API access is required to run this build.
WORKFORCE_LLM_PROVIDER=mock
# ANTHROPIC_API_KEY=   # only read when WORKFORCE_LLM_PROVIDER=anthropic
