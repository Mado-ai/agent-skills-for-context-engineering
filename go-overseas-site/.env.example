# Public base URL of the deployed site (no trailing slash).
# Used for canonical URLs, sitemap.xml, robots.txt, and Open Graph tags.
# Set this in your hosting provider's environment for production.
NEXT_PUBLIC_SITE_URL=https://www.gooverseas.com

# --- Backend API (server-only secrets — never prefix with NEXT_PUBLIC_) ---

# Resend API key for sending contact + newsletter emails.
# Create one at https://resend.com/api-keys. Without it, the /api/contact and
# /api/subscribe routes return HTTP 503.
RESEND_API_KEY=

# Verified sender. The domain must be verified in Resend, or use onboarding@resend.dev for testing.
# Format: "Display Name <address@domain>"
EMAIL_FROM=go overseas <hello@gooverseas.com>

# Inbox that receives contact-form enquiries.
CONTACT_TO_EMAIL=hello@gooverseas.com

# Inbox that receives newsletter signups (optional; defaults to CONTACT_TO_EMAIL).
NEWSLETTER_TO_EMAIL=hello@gooverseas.com
