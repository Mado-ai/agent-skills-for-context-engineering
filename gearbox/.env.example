# Copy to .env for local development. Never commit .env.
NODE_ENV=development
DEPLOYMENT_PROFILE=CLOUD
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

DATABASE_URL=postgres://gearbox:gearbox@localhost:5432/gearbox
REDIS_URL=redis://localhost:6379

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-openssl-rand-base64-48-output
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=gearbox-client
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecretdevsecret
